<section class="featured-products section-space">
  <div class="page-width">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">Best sellers</p>
        <h2>{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ section.settings.button_link }}" class="text-link">{{ section.settings.button_label }}</a>
    </div>

    <div class="product-grid">
      {% assign featured_collection = collections[section.settings.collection] %}
      {% if featured_collection != blank %}
        {% for product in featured_collection.products limit: section.settings.product_limit %}
          <article class="product-card">
            <a href="{{ product.url }}" class="product-image">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
              {% endif %}
            </a>
            <div class="product-meta">
              <h3>{{ product.title }}</h3>
              <p>{{ product.price | money }}</p>
            </div>
          </article>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <article class="product-card placeholder-card">
            <div class="placeholder-image"></div>
            <div class="product-meta">
              <h3>Signature Piece</h3>
              <p>$180.00</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted to be lived with"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
