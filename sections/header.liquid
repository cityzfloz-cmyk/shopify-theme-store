{% liquid
  assign nav_menu = section.settings.menu
%}
<section class="header">
  <div class="announcement-bar">
    <div class="page-width">
      <p>{{ settings.announcement_text }}</p>
    </div>
  </div>

  <div class="page-width header-inner">
    <div class="brand-block">
      <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} home">
        {{ shop.name }}
      </a>
    </div>

    <nav class="main-nav" aria-label="Main navigation">
      {% if section.settings.menu != blank %}
        {% for link in linklists[section.settings.menu].links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">Shop</a>
        <a href="{{ routes.root_url }}">Collections</a>
        <a href="{{ routes.root_url }}">Journal</a>
        <a href="{{ routes.root_url }}">About</a>
      {% endif %}
    </nav>

    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="header-link">Search</a>
      <a href="{{ routes.account_url }}" class="header-link">Account</a>
      <a href="{{ routes.cart_url }}" class="header-link cart-link">
        Cart <span>({{ cart.item_count }})</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu"
    }
  ]
}
{% endschema %}
