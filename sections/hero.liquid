<section class="hero" style="background-image: url('{{ section.settings.image | image_url: width: 1800 }}');">
  <div class="hero-overlay"></div>
  <div class="page-width hero-content">
    <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <div class="hero-actions">
      {% if section.settings.primary_button_label != blank %}
        <a class="button button-primary" href="{{ section.settings.primary_button_link }}">{{ section.settings.primary_button_label }}</a>
      {% endif %}
      {% if section.settings.secondary_button_label != blank %}
        <a class="button button-secondary" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Curated essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury living for the modern home."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Discover elevated pieces designed with thoughtful craftsmanship, soft textures, and timeless detail."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Explore journal"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
