{% doc %}
  @prompt
    Create a compact policy-links block for the bottom of the current product template. Match the existing theme footer colors and typography. Provide an editable menu picker so I can select my existing Footer menu and display its links from the menu, without hardcoding URLs. The menu contains Privacy policy, Refund policy, Shipping policy, Legal notice, Terms of service, Contact info, Search, and Your Privacy Choices. Use accessible readable links that wrap on mobile. Preserve the product content and existing footer. This block is intended for the product template, not the homepage.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-policy-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: inherit;
    font: inherit;
    padding-block: 12px;
  }

  .ai-policy-links-{{ ai_gen_id }}__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: {{ block.settings.alignment }};
    gap: 8px 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-policy-links-{{ ai_gen_id }}__link {
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .ai-policy-links-{{ ai_gen_id }}__link:hover {
    text-decoration-thickness: 2px;
  }

  .ai-policy-links-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-policy-links-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-policy-links-{{ ai_gen_id }}__list {
      justify-content: flex-start;
      gap: 10px 14px;
    }
  }
{% endstyle %}

<div class="ai-policy-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.policy_menu != blank and block.settings.policy_menu.links.size > 0 %}
    <nav aria-label="Policies and store information">
      <ul class="ai-policy-links-{{ ai_gen_id }}__list">
        {% for link in block.settings.policy_menu.links %}
          <li>
            <a class="ai-policy-links-{{ ai_gen_id }}__link" href="{{ link.url }}">{{ link.title | escape }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% elsif request.design_mode %}
    <p>Select a menu to show its policy and store information links.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product policy links",
  "settings": [
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Menu"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Product policy links"
    }
  ],
  "tag": null,
  "class": "product-policy-links"
}
{% endschema %}