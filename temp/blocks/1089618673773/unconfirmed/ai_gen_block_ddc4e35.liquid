{% doc %}
  @prompt
    Create an editable footer block matching this store's current theme. Include editable link labels and destination pickers for Contact, Gift cards, Privacy policy, and Terms of service, so the merchant can select the correct existing store destinations rather than linking to the homepage. Include a navigation-menu picker so the merchant can use their existing Footer menu for policy links. Use a clean mobile-friendly layout and accessible link styling. Do not invent destinations, add testimonials or marketing claims, or duplicate newsletter signup forms.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_vertical }}px 0;
    border-top: 1px solid {{ block.settings.border_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-footer-links__list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-footer-links__link-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-footer-links__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-footer-links__link-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-footer-links-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.padding_vertical | divided_by: 2 }}px 0;
    }

    .ai-footer-links__list-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 14px;
    }
  }
{% endstyle %}

<div class="ai-footer-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <nav aria-label="Footer links">
    <ul class="ai-footer-links__list-{{ ai_gen_id }}">
      {% if block.settings.contact_label != blank and block.settings.contact_url != blank %}
        <li><a class="ai-footer-links__link-{{ ai_gen_id }}" href="{{ block.settings.contact_url }}">{{ block.settings.contact_label | escape }}</a></li>
      {% endif %}
      {% if block.settings.gift_label != blank and block.settings.gift_url != blank %}
        <li><a class="ai-footer-links__link-{{ ai_gen_id }}" href="{{ block.settings.gift_url }}">{{ block.settings.gift_label | escape }}</a></li>
      {% endif %}
      {% if block.settings.footer_menu != blank %}
        {% for link in block.settings.footer_menu.links %}
          <li><a class="ai-footer-links__link-{{ ai_gen_id }}" href="{{ link.url }}">{{ link.title | escape }}</a></li>
        {% endfor %}
      {% else %}
        {% if block.settings.privacy_label != blank and block.settings.privacy_url != blank %}
          <li><a class="ai-footer-links__link-{{ ai_gen_id }}" href="{{ block.settings.privacy_url }}">{{ block.settings.privacy_label | escape }}</a></li>
        {% endif %}
        {% if block.settings.terms_label != blank and block.settings.terms_url != blank %}
          <li><a class="ai-footer-links__link-{{ ai_gen_id }}" href="{{ block.settings.terms_url }}">{{ block.settings.terms_label | escape }}</a></li>
        {% endif %}
      {% endif %}
    </ul>
  </nav>
</div>

{% schema %}
{
  "name": "Footer links",
  "settings": [
    {
      "type": "header",
      "content": "Contact and gift cards"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact label",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact destination"
    },
    {
      "type": "text",
      "id": "gift_label",
      "label": "Gift cards label",
      "default": "Gift cards"
    },
    {
      "type": "url",
      "id": "gift_url",
      "label": "Gift cards destination"
    },
    {
      "type": "header",
      "content": "Policy links"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Footer menu",
      "info": "When selected, the menu links replace the individual policy links below."
    },
    {
      "type": "text",
      "id": "privacy_label",
      "label": "Privacy policy label",
      "default": "Privacy policy"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy policy destination"
    },
    {
      "type": "text",
      "id": "terms_label",
      "label": "Terms of service label",
      "default": "Terms of service"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Terms of service destination"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical spacing",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Link color",
      "default": "#1D1D1B"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Hover color",
      "default": "#8A642E"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider",
      "default": "#D8D0C5"
    }
  ],
  "presets": [
    {
      "name": "Footer links"
    }
  ],
  "tag": null,
  "class": "footer-links-block"
}
{% endschema %}