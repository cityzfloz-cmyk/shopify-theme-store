{% doc %}
  @prompt
    Create a compact, responsive policy-links block for the bottom of my store that matches the existing footer's colors and typography. Include an editable menu picker so I can select my existing Footer menu, and display its links directly from that menu rather than hardcoding them. My Footer menu contains Privacy policy, Refund policy, Shipping policy, Legal notice, Terms of service, Contact info, Search, and Your Privacy Choices. Use accessible, readable links that wrap neatly on mobile. Keep the rest of the existing footer unchanged.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-policy-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.vertical_spacing }}px 0;
    color: {{ block.settings.text_color }};
    font-family: inherit;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.5;
  }

  .ai-policy-links-{{ ai_gen_id }}__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-policy-links-{{ ai_gen_id }}__link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .ai-policy-links-{{ ai_gen_id }}__link:hover {
    color: {{ block.settings.link_hover_color }};
  }

  .ai-policy-links-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
    border-radius: 2px;
  }

  .ai-policy-links-{{ ai_gen_id }}__empty {
    margin: 0;
    color: inherit;
    opacity: 0.8;
  }

  @media screen and (max-width: 749px) {
    .ai-policy-links-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-policy-links-{{ ai_gen_id }}__list {
      justify-content: flex-start;
      gap: 10px 16px;
    }
  }
{% endstyle %}

<div class="ai-policy-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.footer_menu != blank and block.settings.footer_menu.links.size > 0 %}
    <nav aria-label="{{ block.settings.navigation_label | escape }}">
      <ul class="ai-policy-links-{{ ai_gen_id }}__list">
        {% for link in block.settings.footer_menu.links %}
          <li>
            <a class="ai-policy-links-{{ ai_gen_id }}__link" href="{{ link.url }}">{{ link.title | escape }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% else %}
    <p class="ai-policy-links-{{ ai_gen_id }}__empty">Select a menu to display its links.</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Policy links",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Accessible label",
      "default": "Footer policies and links"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Hover link",
      "default": "#b68d4b"
    }
  ],
  "presets": [
    {
      "name": "Policy links"
    }
  ],
  "tag": null,
  "class": "policy-links-block"
}
{% endschema %}