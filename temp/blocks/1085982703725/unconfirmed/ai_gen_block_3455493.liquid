{% doc %}
  @prompt
    Create a refined, elegant Halloween banner section with sophisticated dark aesthetics — deep purples, rich blacks, and gold accents. Include a compelling headline, subtext, and a call-to-action button. The design should feel premium and atmospheric rather than cartoonish, with subtle Halloween motifs like silhouettes or elegant gothic patterns.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-halloween-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: clamp(48px, 8vw, 104px) 24px;
    color: {{ block.settings.text_color }};
    text-align: center;
    background: radial-gradient(ellipse at 50% 0%, {{ block.settings.glow_color }} 0%, transparent 55%), {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.accent_color }};
  }

  .ai-halloween-banner-{{ ai_gen_id }}::before,
  .ai-halloween-banner-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    z-index: -1;
    pointer-events: none;
  }

  .ai-halloween-banner-{{ ai_gen_id }}::before {
    width: clamp(180px, 27vw, 340px);
    aspect-ratio: 1;
    border: 1px solid {{ block.settings.accent_color }};
    border-radius: 50%;
    opacity: 0.19;
    top: -48%;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 0 14px {{ block.settings.background_color }}, 0 0 0 15px {{ block.settings.accent_color }}, 0 0 0 31px {{ block.settings.background_color }}, 0 0 0 32px {{ block.settings.accent_color }};
  }

  .ai-halloween-banner-{{ ai_gen_id }}::after {
    inset: 12px;
    border: 1px solid {{ block.settings.accent_color }};
    opacity: 0.3;
  }

  .ai-halloween-banner-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
  }

  .ai-halloween-banner-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 16px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .ai-halloween-banner-{{ ai_gen_id }}__heading {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(36px, 6vw, 68px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0.015em;
  }

  .ai-halloween-banner-{{ ai_gen_id }}__rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 22px auto 18px;
    color: {{ block.settings.accent_color }};
  }

  .ai-halloween-banner-{{ ai_gen_id }}__rule::before,
  .ai-halloween-banner-{{ ai_gen_id }}__rule::after {
    content: '';
    display: block;
    width: 54px;
    height: 1px;
    background: {{ block.settings.accent_color }};
  }

  .ai-halloween-banner-{{ ai_gen_id }}__diamond {
    width: 7px;
    height: 7px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
  }

  .ai-halloween-banner-{{ ai_gen_id }}__subtext {
    max-width: 560px;
    margin: 0 auto 30px;
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.7;
    opacity: 0.88;
  }

  .ai-halloween-banner-{{ ai_gen_id }}__button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border: 1px solid {{ block.settings.accent_color }};
    background: {{ block.settings.accent_color }};
    color: {{ block.settings.button_text_color }};
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 160ms ease, color 160ms ease;
  }

  .ai-halloween-banner-{{ ai_gen_id }}__button:hover {
    background: transparent;
    color: {{ block.settings.accent_color }};
  }

  .ai-halloween-banner-{{ ai_gen_id }}__button:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 600px) {
    .ai-halloween-banner-{{ ai_gen_id }} {
      padding: 56px 22px;
    }

    .ai-halloween-banner-{{ ai_gen_id }}__subtext {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-halloween-banner-{{ ai_gen_id }}__button {
      transition: none;
    }
  }
{% endstyle %}

<div class="ai-halloween-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-halloween-banner-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-halloween-banner-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    <h2 class="ai-halloween-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <div class="ai-halloween-banner-{{ ai_gen_id }}__rule" aria-hidden="true"><span class="ai-halloween-banner-{{ ai_gen_id }}__diamond"></span></div>
    {% if block.settings.subtext != blank %}
      <p class="ai-halloween-banner-{{ ai_gen_id }}__subtext">{{ block.settings.subtext | escape }}</p>
    {% endif %}
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}
      <a class="ai-halloween-banner-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Elegant Halloween banner",
  "settings": [
    {
      "type": "header",
      "content": "Banner content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A season of shadows"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Enter the enchanted evening"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Discover a darker kind of elegance, with seasonal treasures chosen for memorable nights."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Color and layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#15111D"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Purple glow",
      "default": "#332342"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F7F3EE"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Gold accent",
      "default": "#B68D4B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#1D1D1B"
    }
  ],
  "presets": [
    {
      "name": "Elegant Halloween banner"
    }
  ],
  "tag": null,
  "class": "elegant-halloween-banner-block"
}
{% endschema %}