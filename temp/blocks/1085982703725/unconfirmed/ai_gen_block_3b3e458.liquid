{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: stretch;
    min-height: 440px;
  }

  .ai-editorial-{{ ai_gen_id }}--image-first .ai-editorial-{{ ai_gen_id }}__media {
    order: 0;
  }

  .ai-editorial-{{ ai_gen_id }}--image-first .ai-editorial-{{ ai_gen_id }}__content {
    order: 1;
  }

  .ai-editorial-{{ ai_gen_id }}--text-first .ai-editorial-{{ ai_gen_id }}__media {
    order: 1;
  }

  .ai-editorial-{{ ai_gen_id }}--text-first .ai-editorial-{{ ai_gen_id }}__content {
    order: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__media {
    position: relative;
    min-height: 440px;
    overflow: hidden;
    background: #e8e2da;
  }

  .ai-editorial-{{ ai_gen_id }}__image,
  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 440px;
    object-fit: cover;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder {
    position: relative;
    min-height: 440px;
    height: 100%;
  }

  .ai-editorial-{{ ai_gen_id }}__placeholder svg {
    color: #82786c;
  }

  .ai-editorial-{{ ai_gen_id }}__empty-state {
    position: absolute;
    left: 50%;
    bottom: 20px;
    width: calc(100% - 40px);
    transform: translateX(-50%);
    padding: 10px 14px;
    color: #1d1d1b;
    background: rgba(247, 243, 238, 0.94);
    text-align: center;
    font-size: 13px;
  }

  .ai-editorial-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(32px, 6vw, 88px);
  }

  .ai-editorial-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 18px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__heading {
    max-width: 680px;
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(36px, 5vw, {{ block.settings.heading_size }}px);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }

  .ai-editorial-{{ ai_gen_id }}__rule {
    width: 56px;
    height: 2px;
    margin: 26px 0 20px;
    border: 0;
    background: {{ block.settings.accent_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__body {
    max-width: 520px;
    font-size: 16px;
    line-height: 1.75;
  }

  .ai-editorial-{{ ai_gen_id }}__body p {
    margin: 0 0 14px;
  }

  .ai-editorial-{{ ai_gen_id }}__body p:last-child {
    margin-bottom: 0;
  }

  .ai-editorial-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 0 0 7px;
    border-bottom: 1px solid {{ block.settings.accent_color }};
    color: {{ block.settings.text_color }};
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .ai-editorial-{{ ai_gen_id }}__link:hover {
    color: {{ block.settings.accent_color }};
  }

  .ai-editorial-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-editorial-{{ ai_gen_id }}__layout {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .ai-editorial-{{ ai_gen_id }}--image-first .ai-editorial-{{ ai_gen_id }}__media,
    .ai-editorial-{{ ai_gen_id }}--text-first .ai-editorial-{{ ai_gen_id }}__media {
      order: 0;
    }

    .ai-editorial-{{ ai_gen_id }}--image-first .ai-editorial-{{ ai_gen_id }}__content,
    .ai-editorial-{{ ai_gen_id }}--text-first .ai-editorial-{{ ai_gen_id }}__content {
      order: 1;
    }

    .ai-editorial-{{ ai_gen_id }}__media,
    .ai-editorial-{{ ai_gen_id }}__image,
    .ai-editorial-{{ ai_gen_id }}__placeholder,
    .ai-editorial-{{ ai_gen_id }}__placeholder svg {
      min-height: 300px;
    }

    .ai-editorial-{{ ai_gen_id }}__content {
      padding: 34px 26px 40px;
    }

    .ai-editorial-{{ ai_gen_id }}__heading {
      font-size: clamp(34px, 10vw, {{ block.settings.heading_size }}px);
    }
  }
{% endstyle %}

<div
  class="ai-editorial-{{ ai_gen_id }} ai-editorial-{{ ai_gen_id }}--{{ block.settings.layout }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-{{ ai_gen_id }}__layout">
    <div class="ai-editorial-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img
          class="ai-editorial-{{ ai_gen_id }}__image"
          src="{{ block.settings.image | image_url: width: 1800 }}"
          alt="{{ block.settings.image.alt | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-editorial-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-editorial-{{ ai_gen_id }}__empty-state">Add an editorial image to complete this feature.</div>
        </div>
      {% endif %}
    </div>
    <div class="ai-editorial-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-editorial-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h2 class="ai-editorial-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      <hr class="ai-editorial-{{ ai_gen_id }}__rule">
      {% if block.settings.body != blank %}
        <div class="ai-editorial-{{ ai_gen_id }}__body">{{ block.settings.body }}</div>
      {% endif %}
      {% if block.settings.link_label != blank and block.settings.link_url != blank %}
        <a class="ai-editorial-{{ ai_gen_id }}__link" href="{{ block.settings.link_url }}">
          {{ block.settings.link_label | escape }} <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial feature",
  "settings": [
    {
      "type": "header",
      "content": "Editorial content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Field notes · Issue 01"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "A considered approach to the things we love"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Story",
      "default": "<p>Thoughtful tools and trusted essentials, chosen to make every project and every day feel a little more rewarding.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore the story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout and style"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop order",
      "options": [
        { "value": "image-first", "label": "Image first" },
        { "value": "text-first", "label": "Text first" }
      ],
      "default": "image-first"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Maximum headline size",
      "min": 40,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f3ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#8a642e"
    }
  ],
  "presets": [
    {
      "name": "Editorial feature"
    }
  ],
  "tag": null,
  "class": "editorial-feature-block"
}
{% endschema %}