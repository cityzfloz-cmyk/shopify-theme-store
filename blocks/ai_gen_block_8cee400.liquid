{% doc %}
  @prompt
    Create a compact policy-links block for the bottom of the current product template. Match the existing theme footer colors and typography. Provide an editable menu picker so I can select my existing Footer menu and display its links from the menu, without hardcoding URLs. The menu contains Privacy policy, Refund policy, Shipping policy, Legal notice, Terms of service, Contact info, Search, and Your Privacy Choices. Use accessible readable links that wrap on mobile. Preserve the product content and existing footer. This block is intended for the product template, not the homepage.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-policy-links-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 16px 0;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
    font-family: inherit;
    font-size: 14px;
    line-height: 1.6;
  }

  .ai-policy-links-{{ ai_gen_id }}__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-policy-links-{{ ai_gen_id }}__link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-policy-links-{{ ai_gen_id }}__link:hover {
    text-decoration-thickness: 2px;
  }

  .ai-policy-links-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-policy-links-{{ ai_gen_id }} {
      padding: 14px 8px;
    }

    .ai-policy-links-{{ ai_gen_id }}__list {
      gap: 8px 16px;
    }
  }
{% endstyle %}

<div class="ai-policy-links-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.footer_menu != blank and block.settings.footer_menu.links.size > 0 %}
    <nav aria-label="{{ block.settings.navigation_label | escape }}">
      <ul class="ai-policy-links-{{ ai_gen_id }}__list">
        {% for link in block.settings.footer_menu.links %}
          <li>
            <a class="ai-policy-links-{{ ai_gen_id }}__link" href="{{ link.url }}">{{ link.title | escape }}</a>
          </li>
        {% endfor %}
      </ul>
    </nav>
  {% else %}
    <p>{{ block.settings.empty_message | escape }}</p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Policy links",
  "settings": [
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Menu"
    },
    {
      "type": "text",
      "id": "navigation_label",
      "label": "Navigation label",
      "default": "Policy and useful links"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty menu message",
      "default": "Select a menu to show its links."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f3ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1d1b"
    }
  ],
  "presets": [
    {
      "name": "Policy links"
    }
  ],
  "tag": null,
  "class": "policy-links-block"
}
{% endschema %}